🔮 Prediction API

Endpoint

POST /api/predict

Example Request

{
  "model": "lightgbm",
  "features": {
    "signature_hash_algo": "SHA-256",
    "signature_key_algo": "RSA",
    "public_key_algo": "RSA",
    "public_key_size": 2048,
    "can_issue": "f",
    "pathlen": 0,
    "has_roca": "f",
    "common_name": "google.com",
    "issuer_dn": "CN=Google Trust Services",
    "eku": "serverAuth",
    "san": "*.google.com"
  }
}

Example Response

{
  "classification": "benign",
  "confidence": 0.97,
  "model": "lightgbm"
}


